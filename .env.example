# ============================================================
# RAG Document QA — Environment Configuration
# Copy this file to .env (backend reads it from backend/ or repo root)
# and fill in real values. NEVER commit the real .env file.
# ============================================================

# --- LLM (local Ollama) ---
# No API key required — generation runs entirely on your machine via Ollama.
# Install Ollama (https://ollama.com), run `ollama pull gemma3:4b`, and make
# sure `ollama serve` / the Ollama app is running before starting the backend.
LLM_PROVIDER=ollama
# Reachable at localhost when the backend runs natively (uvicorn/python).
# If the backend runs INSIDE Docker instead, localhost inside the container is
# the container itself, not your machine — use http://host.docker.internal:11434
# on Docker Desktop (Windows/Mac), or the appropriate host-gateway address on
# Linux (e.g. run the container with --add-host=host.docker.internal:host-gateway).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Generation limits, tuned for CPU-only inference on a laptop. A full RAG
# prompt (system + several retrieved chunks) can take 30-90s to answer on
# CPU-only hardware — raise LLM_TIMEOUT_SECONDS further if you see timeouts.
LLM_MAX_TOKENS=256
LLM_TIMEOUT_SECONDS=120

# --- Embeddings ---
# Sentence-Transformers model, downloaded from Hugging Face on first run.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Vector Database (PostgreSQL + pgvector) ---
# Port 5433 (not 5432) is used by docker-compose to avoid clashing with any
# Postgres instance already running natively on the host.
DATABASE_URL=postgresql+psycopg://rag_user:rag_password@localhost:5433/rag_db
# Credentials used by docker-compose to bootstrap the Postgres container.
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_db

# --- RAG pipeline configuration ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
MAX_CONTEXT_CHUNKS=8

# --- File upload limits ---
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./data/uploads

# --- Backend server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
